{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://swift-rx/schemas/swift-r64z-lane-a-diff.v1.json",
  "title": "Lane A vector regression diff (swift-r64z)",
  "description": "Output of diff_lane_a_vectors.exs comparing a lane-a baseline vs a fresh run. result=pass iff no value_changed/missing_vector regressions. Proposed by explorer-mx-a64z (block-023); pending gatekeeper ratification.",
  "type": "object",
  "required": ["schema", "artifact_kind", "created_at_utc", "mode", "namespace", "result", "regressions", "semantics"],
  "properties": {
    "schema": {"type": "string", "const": "swift-r64z.lane-a-diff.v1"},
    "artifact_kind": {"type": "string", "const": "validation"},
    "disposition_authority": {"type": "string"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "mode": {"type": "string", "enum": ["explorer", "gatekeeper"]},
    "namespace": {"type": "string"},
    "baseline": {"type": "object"},
    "run": {"type": "object"},
    "result": {"type": "string", "enum": ["pass", "fail"]},
    "regressions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class", "probe_id", "key"],
        "properties": {
          "class": {"type": "string", "enum": ["value_changed", "missing_vector"]},
          "probe_id": {"type": "string"},
          "key": {"type": "string"},
          "baseline": {},
          "run": {}
        }
      }
    },
    "semantics": {"type": "object"}
  }
}
